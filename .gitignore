# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!pinterest-agent/.env.example
scripts/email-mcp-secrets.local.txt

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Large Exports
Jason_Carroll_Holloway_Final_Export/
website_unzipped/
business_cards/
*.pdf
*.epub
*.zip
*_out.txt
*.py
!pinterest-agent/**/*.py

# Operation Pinboard — secrets & runtime output
pinterest-agent/.env
pinterest-agent/.pinterest_token.json
pinterest-agent/output/
!pinterest-agent/output/.gitkeep
pinterest-agent/logs/
!pinterest-agent/logs/.gitkeep
pinterest-agent/__pycache__/
pinterest-agent/**/__pycache__/
